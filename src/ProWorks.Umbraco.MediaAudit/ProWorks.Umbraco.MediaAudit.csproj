<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ProWorks.Umbraco.MediaAudit</PackageId>
    <Product>ProWorks.Umbraco.MediaAudit</Product>
    <Title>Umbraco Media Audit</Title>
    <Version>0.1.0</Version>
    <Authors>ProWorks.Umbraco.MediaAudit contributors</Authors>
    <Description>Backoffice dashboard for auditing used/unused media in Umbraco v17: classify every media item as Used or Unused, drill into exactly what references a "Used" item, filter/sort/export results, and safely delete or purge confirmed-unused files with a batch-level accountability log.</Description>
    <PackageProjectUrl>https://github.com/ProWorksCorporation/ProWorks.Umbraco.MediaAudit</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>umbraco-marketplace umbraco-package media-audit</PackageTags>
    <RepositoryUrl>https://github.com/ProWorksCorporation/ProWorks.Umbraco.MediaAudit</RepositoryUrl>
    <!-- Marketplace listing sources package name/authors/description/readme/project URL straight from
         NuGet metadata (T059, research.md §2) - PackageReadmeFile is what makes the repo root README
         also serve as the NuGet/Marketplace readme, rather than needing a separate copy. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>


  <ItemGroup>
    <!-- Pinned to the Umbraco v17 LTS line (research.md §1), not "*", which floats onto the next
         major (v18) and breaks the version-locked constraints the `dotnet new umbraco` v17 site
         template pins its own Umbraco.Cms.* references to. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.0.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[17.0.0,18.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0,18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />

    <!-- Repo-root README becomes the NuGet package's README (PackageReadmeFile above) -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
