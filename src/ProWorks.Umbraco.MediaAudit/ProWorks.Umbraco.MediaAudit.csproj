<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ProWorks.Umbraco.MediaAudit</PackageId>
    <Product>ProWorks.Umbraco.MediaAudit</Product>
    <Title>ProWorks Umbraco Media Audit</Title>
    <Version>18.0.2</Version>
    <Authors>ProWorks.Umbraco.MediaAudit contributors</Authors>
    <Description>Audit your Umbraco CMS (v18+) media library right from the backoffice: classify every item as Used or Unused, drill into exactly what references it, and safely delete or purge the rest with a full accountability log.</Description>
    <PackageReleaseNotes>Requires Umbraco CMS 18.0+. This release will not install on Umbraco 17 - the 1.x line on the main branch continues to be maintained separately for Umbraco 17.

- Fixed the items column on UmbracoMediaAuditDeletionLog truncating/rejecting inserts on SQL Server once a delete/purge batch's JSON payload exceeds 255 characters. Widened to nvarchar(max) for new installs, with a migration step to widen it for existing installs too.

Full release notes: https://github.com/ProWorksCorporation/ProWorks.Umbraco.MediaAudit/releases/tag/v18.0.2</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/ProWorksCorporation/ProWorks.Umbraco.MediaAudit</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>umbraco-marketplace umbraco-package media-audit</PackageTags>
    <RepositoryUrl>https://github.com/ProWorksCorporation/ProWorks.Umbraco.MediaAudit</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>audit-icon.png</PackageIcon>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[18.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[18.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[18.0.0,19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[18.0.0,19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\images\audit-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
